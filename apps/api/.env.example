# Choose the LLM provider. "google" uses Gemini (free tier via Google AI
# Studio); "anthropic" uses Claude. Defaults to "google".
LLM_PROVIDER=google

# Required when LLM_PROVIDER=google. Get one at https://aistudio.google.com/app/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=

# Required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model override. Defaults: google → "gemini-2.5-flash",
# anthropic → "claude-sonnet-4-5".
# GALLEY_MODEL=gemini-2.5-flash

# Optional path overrides
# GALLEY_DB=data/galley.sqlite
# GALLEY_UPLOADS=uploads
# GALLEY_LLM_LOGS=llm-logs
# PORT=3001
